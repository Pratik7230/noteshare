# PostgreSQL
DATABASE_URL=postgres://noteshare:noteshare@localhost:5432/noteshare
DATABASE_SSL=false

# Auth (generate with: openssl rand -base64 48). Must be 24+ characters.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Salt for anonymous unique-view hashing (never store raw IPs)
VISITOR_HASH_SALT=change-me-too

# Public URL of the app (used in emails and share links)
APP_URL=http://localhost:3000

# Email. Leave SMTP_URL empty in development: emails are printed to the server console.
# Example: smtp://user:pass@smtp.example.com:587

SMTP_URL=smtps://yourname%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465
MAIL_FROM=NoteShare <yourname@gmail.com>

# Storage: Vercel Blob (production / Vercel deployment)
# Used for note attachments, editor images, and user profile pictures.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx
BLOB_STORE_ID=store_xxxxxxxxxxxxxxxx
BLOB_WEBHOOK_PUBLIC_KEY=xxxxxxxxxxxxxxxx
# BLOB_ACCESS can be "private" (default for new stores) or "public"
BLOB_ACCESS=private

# Fallback: Local disk storage (used when BLOB_READ_WRITE_TOKEN is not set)
UPLOAD_DIR=./uploads

# Optional: lets an external cron call POST /api/cron/cleanup with "Authorization: Bearer <secret>"
CRON_SECRET=
